[sub_resource type="GDScript" id="GDScript_pyidc"]
resource_name = "Movment script"
script/source = "extends CharacterBody2D

const SPEED = 500.0
const JUMP_VELOCITY = -500.0
const WALL_JUMP_PUSH = 400.0  # Horizontal push strength for wall jumps
var jumps = 0

var touching_wall_last_frame = false
var can_wall_reset = true
var wall_normal: Vector2 = Vector2.ZERO

var spawn_position = Vector2(0, 0)  # Where player teleports to
var fall_limit_y = 1000              # Y value where player resets

func _physics_process(delta: float) -> void:
	if not is_on_floor():
		velocity += get_gravity() * delta

	# --- Wall detection ---
	var touching_wall = is_on_wall() and not is_on_floor()
	if touching_wall:
		wall_normal = get_wall_normal()
		# Only reset jumps if player was previously in the air (off the wall)
		if can_wall_reset:
			jumps = 2
			can_wall_reset = false
	else:
		# Player is in air / not touching wall
		wall_normal = Vector2.ZERO
		can_wall_reset = true

	touching_wall_last_frame = touching_wall

	# --- Jumping ---
	if Input.is_action_just_pressed(\"move up\"):
		if jumps > 0:
			# Normal or double jump
			jumps -= 1
			velocity.y = JUMP_VELOCITY
		elif touching_wall:
			# Wall jump
			velocity.y = JUMP_VELOCITY
			velocity.x = wall_normal.x * WALL_JUMP_PUSH
			jumps = 1  # allow one extra jump after wall jump

	# Reset jumps when grounded
	if is_on_floor():
		jumps = 2

	# Clamp so it never goes negative
	if jumps < 0:
		jumps = 0

	# Respawn if player falls too far
	if position.y > fall_limit_y:
		position = spawn_position

	# Movement left/right
	var direction = Input.get_axis(\"move left\", \"move right\")
	if direction != 0:
		velocity.x = direction * SPEED
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)

	if direction:
		if velocity.x > 0: 
			$AnimatedSprite2D.play(\"Idle Right\")
		if velocity.x < 0:
			$AnimatedSprite2D.play(\"Idle Left\")
		move_and_slide()
"

